@echo off
REM Включаем кодировку Windows-1251 для корректного отображения кириллицы
chcp 1251 >nul
REM =========================================================================
REM --- Настройка автоматического запуска send_ping.vbs каждые 10 минут ---
REM =========================================================================

REM Получаем полный путь к папке, где находится этот скрипт.
set "SCRIPT_DIR=%~dp0"
set "VBS_SCRIPT_PATH=%SCRIPT_DIR%send_ping.vbs"
set "TASK_NAME=N8N_Watchdog_Ping"
set "TASK_DESCRIPTION=Автоматический запуск Watchdog-скрипта для n8n каждые 10 минут."

echo.
echo ===================================================================
echo НАЧАЛО УСТАНОВКИ ЗАДАЧИ ПЛАНИРОВЩИКА
echo ===================================================================
echo.

REM 1. Проверяем, существует ли VBS-скрипт
echo Проверка наличия файла VBS-скрипта...
if not exist "%VBS_SCRIPT_PATH%" (
    echo ОШИБКА: Файл send_ping.vbs не найден по пути:
    echo "%VBS_SCRIPT_PATH%"
    echo.
    echo Нажмите любую клавишу для завершения.
    pause
    exit /b 1
)
echo Файл "%VBS_SCRIPT_PATH%" найден.

REM 2. Удаляем старую задачу (если существует)
echo.
echo Попытка удалить старую задачу (если существует): "%TASK_NAME%"
REM Используем команду /QUERY для проверки, чтобы избежать ошибок удаления, но скрываем ее вывод
schtasks /query /tn "%TASK_NAME%" >nul 2>&1
if %errorlevel% equ 0 (
    schtasks /delete /tn "%TASK_NAME%" /f
    echo Старая задача удалена.
) else (
    echo Старая задача не найдена.
)


REM 3. Создаем новую задачу
echo.
echo Создание новой задачи: "%TASK_NAME%"
echo -------------------------------------------------------------------
echo Вывод лога команды SCHTASKS:
REM Удалены >nul 2>&1, чтобы показать лог
schtasks /create /tn "%TASK_NAME%" /tr "wscript.exe //B //Nologo %VBS_SCRIPT_PATH%" /sc MINUTE /mo 10 /st 00:00 /et 23:59 /ru SYSTEM /rl HIGHEST /f /z

echo -------------------------------------------------------------------

if %errorlevel% equ 0 (
    echo.
    echo УСПЕШНО: Задача успешно создана и активирована!
    echo    Запускается каждые 10 минут с правами SYSTEM.
    echo.
) else (
    echo.
    echo ОШИБКА: Не удалось создать задачу.
    echo    Пожалуйста, убедитесь, что скрипт был запущен от имени Администратора.
    echo.
)

REM Ожидание нажатия клавиши
echo Нажмите любую клавишу для закрытия окна...
pause >nul