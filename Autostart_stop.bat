@echo off
REM Включаем кодировку Windows-1251 для корректного отображения кириллицы
chcp 1251 >nul
REM =========================================================================
REM --- Скрипт для удаления задачи Watchdog из Планировщика заданий ---
REM =========================================================================

set "TASK_NAME=N8N_Watchdog_Ping"

echo.
echo ===================================================================
echo УДАЛЕНИЕ ЗАДАЧИ ПЛАНИРОВЩИКА
echo ===================================================================
echo.

REM Проверяем наличие задачи перед удалением
echo Проверка наличия задачи "%TASK_NAME%"...
schtasks /query /tn "%TASK_NAME%" >nul 2>&1

if %errorlevel% equ 0 (
    echo Задача найдена. Выполняется удаление...
    
    REM Команда удаления задачи: /delete /tn - имя задачи, /f - принудительное удаление
    schtasks /delete /tn "%TASK_NAME%" /f
    
    if %errorlevel% equ 0 (
        echo.
        echo УСПЕШНО: Задача "%TASK_NAME%" успешно удалена.
        echo    Процесс отправки пингов остановлен.
        echo.
    ) else (
        echo.
        echo ОШИБКА УДАЛЕНИЯ: Не удалось удалить задачу.
        echo    Пожалуйста, убедитесь, что скрипт запущен от имени Администратора.
        echo.
    )
) else (
    echo.
    echo ?? Информация: Задача "%TASK_NAME%" не найдена в Планировщике.
    echo    Удаление не требуется.
    echo.
)

REM Ожидание нажатия клавиши
echo Нажмите любую клавишу для закрытия окна...
pause >nul